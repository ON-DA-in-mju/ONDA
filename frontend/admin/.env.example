# 이 파일을 복사해서 .env.local 로 만든 뒤 값을 넣으세요.
# cp .env.example .env.local
# .env.local 은 GitHub에 올리지 않습니다.

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# 네이버 클라우드 Maps → Web Dynamic Map Client ID
VITE_NAVER_MAP_CLIENT_ID=your_ncp_key_id
# 신규 콘솔: ncpKeyId (기본) / 구 콘솔: ncpClientId
# VITE_NAVER_MAP_KEY_PARAM=ncpKeyId

# Directions 5 (Vite 서버 전용, VITE_ 붙이지 않음)
# NAVER_MAP_CLIENT_SECRET=your_client_secret
