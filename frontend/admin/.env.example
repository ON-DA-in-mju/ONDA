# Supabase (Vite — must start with VITE_)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Naver Cloud Platform — Maps > Application
# Client ID: 웹 지도 (VITE_ 로 브라우저에 노출됨)
# Client Secret: Directions 길찾기 서버 프록시 전용. VITE_ 붙이지 말 것.
VITE_NAVER_MAP_CLIENT_ID=YOUR_NAVER_MAP_CLIENT_ID
NAVER_MAP_CLIENT_SECRET=YOUR_NAVER_MAP_CLIENT_SECRET
