{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --prefix frontend/admin",
  "buildCommand": "npm run build --prefix frontend/admin",
  "outputDirectory": "frontend/admin/dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
