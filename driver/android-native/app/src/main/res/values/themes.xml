<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ 는 앱 실행 시 시스템 스플래시를 강제로 보여줍니다.
      아이콘을 투명 처리해 흰 화면만 잠깐 지나고 Compose(DRI-00-00)로 이어지게 합니다.
    -->
    <style name="Theme.OndaDriver.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.OndaDriver</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <style name="Theme.OndaDriver" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
